@@ -0,0 +1,26 @@
+[package]
+name = "horizon-e4mc"
+version = "0.1.0"
+edition = "2024"
+license = "MIT"
+description = "Open the world to anyone, anywhere: e4mc's public relay ported to Horizon (a QUIC session with the relay carries the invite domain, its streams carry the guests)"
+
+[dependencies]
+# QUIC client for the relay session (the relay itself is quinn + rustls).
+# ring as the crypto provider: the aws-lc-rs default drags a C toolchain into
+# every build machine for no gain here.
+quinn = { version = "0.11", default-features = false, features = ["runtime-tokio", "rustls-ring"] }
+rustls = { version = "0.23", default-features = false, features = ["ring", "std", "tls12"] }
+webpki-roots = "0.26"
+tokio = { version = "1", default-features = false, features = ["rt", "net", "time", "sync", "io-util", "macros"] }
+# The broker answer and the control channel are JSON.
+serde = { version = "1", features = ["derive"] }
+serde_json = "1.0.151"
+# Errors across the tokio boundary, the quinn TLS setup.
+anyhow = "1"
+# HTTPS to the relay broker (rustls underneath, already in the tree via the client).
+ureq = { version = "2", default-features = false, features = ["tls", "json"] }
+log = { version = "0.4", features = ["std"] }
+
+[lints]
+workspace = true
diff --git a/crates/horizon-e4mc/src/control.rs b/crates/horizon-e4mc/src/control.rs
new file mode 100644
index 000000000..2dd448245
--- /dev/null
+++ b/crates/horizon-e4mc/src/control.rs
@@ -0,0 +1,215 @@
+//! The quiclime control channel: messages are JSON with a `kind` field,
+//! framed by a varint length, one message per frame, both ways. The client
+//! asks for a domain, the relay answers with one and then opens one
+//! bidirectional stream per guest, which this crate bridges to the world.
+
+/// The serverbound messages this client sends (e4mc's
+/// `ControlMessageCodec`, the subset a host needs).
+#[derive(Debug, PartialEq, Eq)]
+pub enum Serverbound {
+    ProbeCapabilities,
+    RequestDomainAssignment,
+}
+
+/// The clientbound messages (e4mc's clientbound control messages).
+#[derive(Debug, PartialEq, Eq)]
+pub enum Clientbound {
+    /// The relay's capabilities (e4mc probes them before registering).
+    HasCapabilities(Vec<String>),
+    /// The world's public address is ready.
+    DomainAssignmentComplete(String),
+    /// A relay-wide note the player should see.
+    RequestMessageBroadcast(String),
+    TicketRegistered,
+    UnknownMessage,
+}
+
+impl Serverbound {
+    pub fn to_json(&self) -> Vec<u8> {
+        let kind = match self {
+            Self::ProbeCapabilities => "probe_capabilities",
+            Self::RequestDomainAssignment => "request_domain_assignment",
+        };
+        format!("{{\"kind\":\"{kind}\"}}").into_bytes()
+    }
+}
+
+/// One frame: varint length + the JSON body.
+pub fn frame(message: &[u8]) -> Vec<u8> {
+    let mut out = Vec::with_capacity(message.len() + 5);
+    let mut length = message.len();
+    loop {
+        let byte = (length & 0x7f) as u8;
+        length >>= 7;
+        if length == 0 {
+            out.push(byte);
+            break;
+        }
+        out.push(byte | 0x80);
+    }
+    out.extend_from_slice(message);
+    out
+}
+
+/// A streaming decoder for relay frames: feed it whatever arrived, it hands
+/// back complete messages. `Err` on a frame that claims an impossible size.
+#[derive(Default)]
+pub struct Decoder {
+    buf: Vec<u8>,
+}
+
+impl Decoder {
+    pub fn feed(&mut self, bytes: &[u8]) -> Result<Vec<Clientbound>, &'static str> {
+        self.buf.extend_from_slice(bytes);
+        let mut out = Vec::new();
+        loop {
+            let Some((length, header)) = varint(&self.buf) else {
+                return Ok(out);
+            };
+            if length > 8192 {
+                return Err("the relay sent an oversized control frame");
+            }
+            let end = header + length;
+            if self.buf.len() < end {
+                return Ok(out);
+            }
+            let body = &self.buf[header..end];
+            let Ok(json) = serde_json::from_slice::<serde_json::Value>(body) else {
+                self.buf.drain(..end);
+                out.push(Clientbound::UnknownMessage);
+                continue;
+            };
+            let message = match json.get("kind").and_then(|k| k.as_str()) {
+                Some("has_capabilities") => Clientbound::HasCapabilities(
+                    json.get("caps")
+                        .and_then(|c| c.as_array())
+                        .map(|caps| {
+                            caps.iter()
+                                .filter_map(|c| c.as_str().map(str::to_owned))
+                                .collect()
+                        })
+                        .unwrap_or_default(),
+                ),
+                Some("domain_assignment_complete") => {
+                    match json.get("domain").and_then(|d| d.as_str()) {
+                        Some(domain) => Clientbound::DomainAssignmentComplete(domain.to_owned()),
+                        None => return Err("the relay's domain frame holds no domain"),
+                    }
+                }
+                Some("request_message_broadcast") => Clientbound::RequestMessageBroadcast(
+                    json.get("message")
+                        .and_then(|m| m.as_str())
+                        .unwrap_or_default()
+                        .to_owned(),
+                ),
+                Some("ticket_registered") => Clientbound::TicketRegistered,
+                _ => Clientbound::UnknownMessage,
+            };
+            self.buf.drain(..end);
+            out.push(message);
+        }
+    }
+}
+
+/// A protocol varint: the value and how many bytes it took.
+fn varint(buf: &[u8]) -> Option<(usize, usize)> {
+    let mut value = 0usize;
+    for (i, &b) in buf.iter().take(5).enumerate() {
+        value |= usize::from(b & 0x7f) << (i * 7);
+        if b & 0x80 == 0 {
+            return Some((value, i + 1));
+        }
+    }
+    None
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn frames_round_trip_through_the_decoder() {
+        let mut decoder = Decoder::default();
+        let messages = decoder
+            .feed(
+                &[
+                    frame(br#"{"kind":"has_capabilities","caps":["dialtone_sidecar"]}"#),
+                    frame(br#"{"kind":"domain_assignment_complete","domain":"gone.e4mc.link"}"#),
+                    frame(br#"{"kind":"request_message_broadcast","message":"hello"}"#),
+                    frame(br#"{"kind":"ticket_registered"}"#),
+                ]
+                .concat(),
+            )
+            .unwrap();
+        assert_eq!(
+            messages,
+            vec![
+                Clientbound::HasCapabilities(vec!["dialtone_sidecar".into()]),
+                Clientbound::DomainAssignmentComplete("gone.e4mc.link".into()),
+                Clientbound::RequestMessageBroadcast("hello".into()),
+                Clientbound::TicketRegistered,
+            ]
+        );
+    }
+
+    #[test]
+    fn frames_arriving_in_pieces_decode() {
+        let whole = frame(br#"{"kind":"domain_assignment_complete","domain":"gone.e4mc.link"}"#);
+        let mut decoder = Decoder::default();
+        let mut messages = Vec::new();
+        for chunk in whole.chunks(3) {
+            messages.extend(decoder.feed(chunk).unwrap());
+        }
+        assert_eq!(
+            messages,
+            vec![Clientbound::DomainAssignmentComplete(
+                "gone.e4mc.link".into()
+            )]
+        );
+    }
+
+    #[test]
+    fn unknown_kinds_and_broken_json_become_unknown() {
+        let mut decoder = Decoder::default();
+        let messages = decoder
+            .feed(&[frame(br#"{"kind":"frobnicate"}"#), frame(b"not json")].concat())
+            .unwrap();
+        assert_eq!(messages.len(), 2);
+        assert!(matches!(messages[0], Clientbound::UnknownMessage));
+        assert!(matches!(messages[1], Clientbound::UnknownMessage));
+    }
+
+    #[test]
+    fn oversized_frames_are_refused() {
+        let mut decoder = Decoder::default();
+        assert!(decoder.feed(&[0xff, 0xff, 0xff, 0xff, 0x7f]).is_err());
+    }
+
+    #[test]
+    fn serverbound_messages_serialize_like_the_java_mods() {
+        assert_eq!(
+            Serverbound::ProbeCapabilities.to_json(),
+            br#"{"kind":"probe_capabilities"}"#.to_vec()
+        );
+        assert_eq!(
+            Serverbound::RequestDomainAssignment.to_json(),
+            br#"{"kind":"request_domain_assignment"}"#.to_vec()
+        );
+    }
+
+    #[test]
+    fn frames_carry_multi_byte_lengths() {
+        // A domain long enough that its frame's varint length takes two bytes.
+        let domain = format!("{}{}", "x".repeat(266), ".e4mc.link");
+        let body = format!(r#"{{"kind":"domain_assignment_complete","domain":"{domain}"}}"#);
+        let framed = frame(body.as_bytes());
+        assert!(framed.len() > 255);
+        let mut decoder = Decoder::default();
+        let messages = decoder.feed(&framed).unwrap();
+        assert_eq!(
+            messages,
+            vec![Clientbound::DomainAssignmentComplete(domain)]
+        );
+        assert!(decoder.buf.is_empty(), "the whole frame should be consumed");
+    }
+}
diff --git a/crates/horizon-e4mc/src/lib.rs b/crates/horizon-e4mc/src/lib.rs
new file mode 100644
index 000000000..ce70538aa
--- /dev/null
+++ b/crates/horizon-e4mc/src/lib.rs
@@ -0,0 +1,310 @@
+//! Open the world to anyone, anywhere: e4mc ported to Horizon.
+//!
+//! e4mc is the Minecraft mod that publishes an open-to-LAN world through its
+//! public relay: the host connects out to a quiclime relay over QUIC, the
+//! relay assigns the world a public domain, and every guest who joins that
+//! domain arrives as one bidirectional stream on the host's session, which
+//! this crate bridges to the integrated server's loopback port byte for
+//! byte. No port forwarding, no Steam, no account: the address is the
+//! world's, and anyone with it can join — e4mc's own design ("Open a LAN
+//! server to anyone, anywhere, anytime"), so the player is told what
+//! publishing means before they press the button.
+//!
+//! Guests need nothing from this crate: the domain is a plain server
+//! address that any client understands, Horizon's and vanilla's alike.
+//! The reference implementation is e4mc-minecraft-architectury's
+//! `QuiclimeSession` with [e4mc-quiclime] on the relay side; the wire
+//! protocol (ALPN `quiclime`, varint-framed JSON control messages, one
+//! stream per guest) is the same.
+//!
+//! [e4mc-quiclime]: https://github.com/vgskye/e4mc-quiclime
+pub mod control;
+pub mod session;
+
+use session::{SessionConfig, SessionState, Shared};
+use std::{
+    net::SocketAddr,
+    sync::{
+        Arc, Mutex,
+        atomic::{AtomicBool, Ordering},
+        mpsc::{Receiver, Sender, channel},
+    },
+    thread::JoinHandle,
+};
+
+/// How many guests the world carries at once (the integrated server's own
+/// limit; the relay's stream budget is 512).
+pub const MAX_GUESTS: usize = 8;
+
+/// How publishing is set up.
+pub struct PublishConfig {
+    /// The integrated server's loopback address (Open to LAN's port).
+    pub lan: SocketAddr,
+    /// A specific relay, skipping the broker (a self-hosted quiclime or a
+    /// test). None: the broker's least loaded relay.
+    pub relay: Option<(String, u16)>,
+}
+
+/// What the game shows.
+#[derive(Clone, Debug, Default)]
+pub struct PublishState {
+    /// The world's public address (`<name>.e4mc.link`), once assigned.
+    pub domain: Option<String>,
+    /// Guests being carried right now.
+    pub guests: usize,
+    /// Why publishing isn't serving, when the player asked for it.
+    pub problem: Option<String>,
+}
+
+/// What the publisher reports, polled like a tick.
+#[derive(Debug)]
+pub enum PublishEvent {
+    /// The world's public address is ready.
+    Published { domain: String },
+    /// A note the relay asked every host to show its players.
+    Broadcast(String),
+    /// A guest's stream is being carried.
+    GuestJoined,
+    /// The guest's stream ended.
+    GuestLeft,
+    /// The session failed (text for the player).
+    Problem(String),
+}
+
+struct Inner {
+    config: PublishConfig,
+    events: Mutex<Sender<PublishEvent>>,
+    state: Arc<Mutex<SessionState>>,
+    guests: Arc<std::sync::atomic::AtomicUsize>,
+    stop: Arc<tokio::sync::watch::Sender<bool>>,
+    stopped: AtomicBool,
+    thread: Mutex<Option<JoinHandle<()>>>,
+}
+
+/// The publisher, like `horizon_friends::Host`: started in the background,
+/// the game polls it.
+pub struct Publish {
+    inner: Arc<Inner>,
+    events: Receiver<PublishEvent>,
+}
+
+impl Publish {
+    /// Start publishing: reach the relay, publish the domain (a few seconds
+    /// at most), start serving guests.
+    pub fn start(config: PublishConfig) -> Result<Self, String> {
+        let (tx, events) = channel();
+        let (stop, _) = tokio::sync::watch::channel(false);
+        let state = Arc::new(Mutex::new(SessionState::default()));
+        let inner = Arc::new(Inner {
+            config,
+            events: Mutex::new(tx),
+            state: state.clone(),
+            guests: Arc::new(std::sync::atomic::AtomicUsize::new(0)),
+            stop: Arc::new(stop),
+            stopped: AtomicBool::new(false),
+            thread: Mutex::new(None),
+        });
+        let shared = Arc::new(Shared {
+            config: SessionConfig {
+                lan: inner.config.lan,
+                relay: inner.config.relay.clone(),
+            },
+            events: inner.events.lock().unwrap().clone(),
+            state,
+            guests: inner.guests.clone(),
+            stop: inner.stop.clone(),
+        });
+        let thread = std::thread::Builder::new()
+            .name("horizon-e4mc".into())
+            .spawn({
+                let shared = shared.clone();
+                move || session::run(shared)
+            })
+            .map_err(|e| format!("e4mc publishing's thread could not start: {e}"))?;
+        *inner.thread.lock().unwrap() = Some(thread);
+        Ok(Self { inner, events })
+    }
+
+    pub fn state(&self) -> PublishState {
+        let session = self.inner.state.lock().unwrap();
+        PublishState {
+            domain: session.domain.clone(),
+            guests: self.inner.guests.load(Ordering::Relaxed),
+            problem: session.problem.clone(),
+        }
+    }
+
+    pub fn poll(&self) -> Vec<PublishEvent> {
+        self.events.try_iter().collect()
+    }
+
+    /// The guests being carried right now.
+    pub fn sessions(&self) -> usize {
+        self.inner.guests.load(Ordering::Relaxed)
+    }
+
+    /// End the publish: the session closes and the domain stops answering.
+    /// Guests already playing are dropped with it: the domain's routing is
+    /// the session, there is nothing to hand over.
+    pub fn stop(&self) {
+        if self.inner.stopped.swap(true, Ordering::Relaxed) {
+            return;
+        }
+        let _ = self.inner.stop.send(true);
+        if let Some(thread) = self.inner.thread.lock().unwrap().take() {
+            let _ = thread.join();
+        }
+    }
+}
+
+impl Drop for Publish {
+    fn drop(&mut self) {
+        self.stop();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    struct PrintLogger;
+    impl log::Log for PrintLogger {
+        fn enabled(&self, _: &log::Metadata) -> bool {
+            true
+        }
+        fn log(&self, record: &log::Record) {
+            eprintln!("[log] {}", record.args());
+        }
+        fn flush(&self) {}
+    }
+    use super::*;
+    use std::time::Duration;
+
+    /// Stop before anything happened: the state stays empty, no panic.
+    #[test]
+    fn a_stopped_publish_reports_nothing() {
+        let publish = Publish::start(PublishConfig {
+            lan: "127.0.0.1:25565".parse().unwrap(),
+            // The broker is never reached: stopped first thing.
+            relay: Some(("127.0.0.1".into(), 1)),
+        })
+        .unwrap();
+        drop(publish);
+    }
+
+    /// The full chain against the real broker and relay: the domain is
+    /// assigned, a guest joining it arrives at the world's port, bytes flow
+    /// both ways, and stopping tears the session down. `--ignored`: only
+    /// for manual runs, it needs the network and e4mc's public service.
+    #[test]
+    #[ignore = "reaches e4mc's public broker and relay"]
+    fn the_relay_publishes_and_serves_a_guest_end_to_end() {
+        use std::io::{Read, Write};
+        let lan = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+        let lan_address = lan.local_addr().unwrap();
+        let publish = Publish::start(PublishConfig {
+            lan: lan_address,
+            relay: None,
+        })
+        .unwrap();
+        let domain = (|| {
+            for _ in 0..150 {
+                for event in publish.poll() {
+                    if let PublishEvent::Published { domain } = event {
+                        return Some(domain);
+                    }
+                }
+                std::thread::sleep(Duration::from_millis(100));
+            }
+            None
+        })()
+        .expect("no domain arrived");
+        eprintln!("e4mc-test: domain {domain}, joining as a guest...");
+        let _ = log::set_boxed_logger(Box::new(PrintLogger));
+        log::set_max_level(log::LevelFilter::Info);
+        assert!(domain.ends_with(".e4mc.link"), "{domain}");
+        assert_eq!(publish.state().domain.as_deref(), Some(domain.as_str()));
+
+        // A guest joins the domain like any vanilla client would: its first
+        // bytes are the Minecraft handshake, whose virtual host names the
+        // domain; the relay routes on it and forwards the packet as-is.
+        let handshake = {
+            fn varint(mut value: usize, out: &mut Vec<u8>) {
+                loop {
+                    let byte = (value & 0x7f) as u8;
+                    value >>= 7;
+                    if value == 0 {
+                        out.push(byte);
+                        break;
+                    }
+                    out.push(byte | 0x80);
+                }
+            }
+            fn string(value: &str, out: &mut Vec<u8>) {
+                varint(value.len(), out);
+                out.extend_from_slice(value.as_bytes());
+            }
+            let mut body = vec![0x00]; // packet id: handshake
+            varint(767, &mut body); // protocol
+            string(&domain, &mut body); // the virtual host the client dialed
+            body.extend_from_slice(&25565u16.to_be_bytes());
+            varint(2, &mut body); // next state: login
+            let mut packet = Vec::new();
+            varint(body.len(), &mut packet);
+            packet.extend_from_slice(&body);
+            packet
+        };
+        use std::net::ToSocketAddrs;
+        let guest_address = (domain.as_str(), 25565)
+            .to_socket_addrs()
+            .expect("dns")
+            .next()
+            .expect("the domain didn't resolve");
+        eprintln!("e4mc-test: guest dials {guest_address}");
+        let mut guest = None;
+        for _ in 0..30 {
+            match std::net::TcpStream::connect_timeout(&guest_address, Duration::from_secs(1)) {
+                Ok(stream) => {
+                    guest = Some(stream);
+                    break;
+                }
+                Err(_) => std::thread::sleep(Duration::from_millis(500)),
+            }
+        }
+        let mut guest = guest.expect("the domain didn't answer");
+        eprintln!("e4mc-test: guest connected, sending the handshake");
+        guest.write_all(&handshake).unwrap();
+        let mut buffer = vec![0u8; handshake.len()];
+        lan.set_nonblocking(false).unwrap();
+        let (mut world, _) = lan.accept().unwrap();
+        world.read_exact(&mut buffer).unwrap();
+        assert_eq!(
+            buffer, handshake,
+            "the relay must forward the handshake verbatim"
+        );
+        eprintln!("e4mc-test: handshake reached the world, playing bytes...");
+        guest.write_all(b"hello").unwrap();
+        let mut rest = [0u8; 5];
+        world.read_exact(&mut rest).unwrap();
+        assert_eq!(&rest, b"hello");
+        world.write_all(b"world").unwrap();
+        let mut back = [0u8; 5];
+        guest.read_exact(&mut back).unwrap();
+        assert_eq!(&back, b"world");
+        assert_eq!(publish.sessions(), 1);
+
+        // Stopping ends the session: the guest's stream closes.
+        publish.stop();
+        eprintln!("e4mc-test: stopped, waiting for the guest's EOF...");
+        guest
+            .set_read_timeout(Some(Duration::from_secs(20)))
+            .unwrap();
+        let mut ended = [0u8; 1];
+        assert_eq!(guest.read(&mut ended).unwrap(), 0);
+        for _ in 0..50 {
+            if publish.sessions() == 0 {
+                break;
+            }
+            std::thread::sleep(Duration::from_millis(100));
+        }
+        assert_eq!(publish.sessions(), 0);
+    }
+}
